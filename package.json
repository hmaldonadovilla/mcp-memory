{
  "name": "@hmaldonadovilla/mcp-memory",
  "version": "0.1.0",
  "description": "Durable MongoDB knowledge graph and semantic retrieval over MCP stdio and Streamable HTTP",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Hector Maldonado",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmaldonadovilla/mcp-memory.git"
  },
  "homepage": "https://github.com/hmaldonadovilla/mcp-memory#readme",
  "bugs": {
    "url": "https://github.com/hmaldonadovilla/mcp-memory/issues"
  },
  "bin": {
    "mcp-memory": "bin/mcp-memory.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "NOTICE",
    "docs/upstream.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:integration": "npm run build && node scripts/with-mongodb.mjs npx --no-install vitest run --config vitest.integration.config.ts",
    "pack:verify": "npm run build && node scripts/with-mongodb.mjs node scripts/pack-verify.mjs",
    "local:gate": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run build && npm run test:integration && npm run pack:verify && npm run image:verify",
    "prepare": "npm run build",
    "prepublishOnly": "npm run local:gate",
    "image:verify": "node scripts/image-verify.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "mongodb": "7.7.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@mcp-v1/sdk": "npm:@modelcontextprotocol/sdk@1.32.2",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.1.12",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
